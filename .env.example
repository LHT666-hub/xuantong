# ─── 玄同 Xuantong 环境配置 ───────────────────────────────────────────────

# Database
# 开发环境（SQLite）
DATABASE_URL=sqlite+aiosqlite:///./xuantong.db
# 生产环境（PostgreSQL/Supabase）
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# Supabase
SUPABASE_URL=
SUPABASE_KEY=

# LLM Provider（mock / qwen / deepseek）
LLM_PROVIDER=qwen
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# LLM 多模型分层配置
LLM_MODEL_LEAD=qwen3-max
LLM_MODEL_SPECIALIST=qwen-plus
LLM_MODEL_EXECUTION=qwen-flash
LLM_MODEL_VISION=qwen3-vl-flash
LLM_MODEL_OCR=qwen-vl-ocr
LLM_MODEL_ASR=qwen3-asr-flash

# LLM 调用参数
LLM_TIMEOUT=60.0
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0

# App
DEBUG=false

# --- Authentication ---
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Observability ---
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=*

# Tracing (LangSmith)
ENABLE_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=xuantong

# --- RAG ---
RAG_ENABLED=true
RAG_MAX_RETRIES=3
RAG_TOP_K=5
RAG_RELEVANCE_THRESHOLD=0.5
RAG_DATA_DIR=app/xuantong/rag/data
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_BM25_ENABLED=true
RAG_VECTOR_ENABLED=true
RAG_VECTOR_DIM=256
RAG_VECTOR_NGRAM=3
RAG_RRF_K=60
RAG_USE_RERANKER=true

# --- Workflow ---
# LangGraph checkpointer 后端：memory（开发默认）/ postgres（生产，需 pip install -e ".[postgres]"）
WORKFLOW_CHECKPOINT_BACKEND=memory
