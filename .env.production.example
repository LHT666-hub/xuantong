# 复制为 .env.production，仅保存在 ECS；不要提交真实值。
ENVIRONMENT=production
DEBUG=false

# RDS PostgreSQL 内网地址；密码含特殊字符时需 URL 编码。
DATABASE_URL=postgresql+asyncpg://xuantong:replace-me@pgm-example.pg.rds.aliyuncs.com:5432/xuantong
WORKFLOW_CHECKPOINT_BACKEND=postgres

LLM_PROVIDER=qwen
LLM_API_KEY=replace-with-new-bailian-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_LEAD=qwen3-max
LLM_MODEL_SPECIALIST=qwen-plus
LLM_MODEL_EXECUTION=qwen-flash
LLM_MODEL_NUTRITION=qwen3.8-flash
LLM_MODEL_VISION=qwen3-vl-flash
LLM_MODEL_OCR=qwen3.5-ocr
LLM_MODEL_ASR=qwen3-asr-flash

# 可选医疗模型。启用时必须填写新密钥。
USE_MEDICAL_MODEL=false
NOVITA_API_KEY=
NOVITA_BASE_URL=https://api.novita.ai/openai
MEDICAL_MODEL_ID=inclusionai/ling-3.0-flash-sante

# 可选若木证据检索。启用时必须填写新密钥。
RUOMU_ENABLED=false
RUOMU_ACCESS_KEY=
RUOMU_BASE_URL=https://bailian-kb-chat.2947520194.workers.dev

# 使用 `openssl rand -hex 32` 生成，不得使用示例值。
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

API_AUTH_REQUIRED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=12

# 原生 iOS 不依赖 CORS；保持为空。若增加 Web 管理端，填写精确 HTTPS 域名。
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=INFO
RAG_ENABLED=true
ENABLE_TRACING=false
